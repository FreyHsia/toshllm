+    auto * comm_ctx = new ggml_backend_metal_comm_context;
+    comm_ctx->backends.assign(backends, backends + n_backends);
+    comm_ctx->tmp.assign(n_backends, nullptr);
+    comm_ctx->tmp_size.assign(n_backends, 0);
+
+    return comm_ctx;
