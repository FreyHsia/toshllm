+            device float * dst_f32 = (device float *) dst + (uint64_t)i1m*args.ne0*args.ne1 + (uint64_t)(i11 + ir1)*args.ne0;
+
+            for (short ir0 = 0; ir0 < nr0; ++ir0) {
+                if (i01 + ir0 < args.ne01) {
+                    dst_f32[i01 + ir0] = sumf[ir0][ir1];
+                }
+            }
+        }
+    }
+}
