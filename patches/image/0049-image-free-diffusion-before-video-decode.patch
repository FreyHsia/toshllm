+// The sampler keeps the diffusion weights in video memory until the whole run ends, and
+// the video decoder then has to fit next to them: a 5B in fp16 leaves under 2 GB free on a
+// 12 GB card and the decode setup fails there. Only call this once no sampling pass is left,
+// which on the LTX hires path is after the upscale refine, not after the first sampling.
+static void release_diffusion_weights(sd_ctx_t* sd_ctx) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || sd_ctx->sd->model_manager == nullptr) {
+        return;
+    }
+    const std::shared_ptr<DiffusionModelRunner> runners[] = {sd_ctx->sd->diffusion_model,
+                                                             sd_ctx->sd->high_noise_diffusion_model};
+    for (const std::shared_ptr<DiffusionModelRunner>& runner : runners) {
+        if (runner == nullptr) {
+            continue;
+        }
+        runner->runner_done();
+        std::map<std::string, ggml_tensor*> params;
+        runner->get_param_tensors(params);
+        std::vector<ggml_tensor*> tensors;
+        tensors.reserve(params.size());
+        for (const auto& pair : params) {
+            tensors.push_back(pair.second);
+        }
+        sd_ctx->sd->model_manager->unload_params(tensors);
+    }
+}
